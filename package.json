{
  "name": "pinboard-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:css",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:policy": "node scripts/check-policy.mjs",
    "docs:readme": "node scripts/docs-readme.mjs",
    "docs:check": "node scripts/docs-readme.mjs --check",
    "verify": "npm run lint && npm run check:policy && npm run docs:check && npm run typecheck && npm test && npm run build",
    "mock": "json-server mock/db.json --port 4001 --routes mock/routes.json --middlewares mock/middleware.cjs",
    "prepare": "node scripts/git-hooks.mjs install"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-devtools": "^5.90.0",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^15.0.0",
    "jsdom": "^30.0.0",
    "json-server": "0.17.4",
    "msw": "^2.15.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.33",
    "postcss-custom-media": "^12.0.4",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
